APP_ENV=local
KAIROS_LOCAL_MODE=false
DATABASE_URL=postgresql+asyncpg://kairos:kairos@127.0.0.1:5434/kairos
TEMPORAL_TARGET=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=kairos-agent-task-queue
MODEL_CONFIG_ID=local-model
MODEL_ID=deepseek:deepseek-chat
MODEL_CREDENTIAL_ENV=DEEPSEEK_API_KEY
SEARCH_PROVIDER_TYPE=tavily
SEARCH_PROVIDER_CREDENTIAL_ENV=TAVILY_API_KEY
SEARCH_PROVIDER_BASE_URL=https://api.tavily.com
# Set only in the worker/API process environment; never put this in workflow input or deps.
# DEEPSEEK_API_KEY=
# TAVILY_API_KEY=
