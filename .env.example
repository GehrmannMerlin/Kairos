# ============================================================================
# Kairos 本地开发环境变量示例
# 复制为 .env 后按需修改。本文件只能包含变量名与安全示例值。
# ============================================================================

# ---- 基础设施 (docker compose infra/compose/compose.yaml) ----
POSTGRES_DB=kairos
POSTGRES_USER=kairos
POSTGRES_PASSWORD=kairos_dev_password
POSTGRES_PORT=5434

TEMPORAL_UI_PORT=8088

MINIO_ACCESS_KEY=kairos_minio
MINIO_SECRET_KEY=kairos_minio_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

OTEL_COLLECTOR_PORT=4317

# ---- 后端 API / Worker (host 运行方式时使用 localhost 地址) ----
KAIROS_ENV=dev
KAIROS_DATABASE_URL=postgresql+psycopg://kairos:kairos_dev_password@localhost:5434/kairos
KAIROS_TEMPORAL_ADDRESS=localhost:8233
KAIROS_TEMPORAL_NAMESPACE=default
KAIROS_S3_ENDPOINT=localhost:9000
KAIROS_S3_ACCESS_KEY=kairos_minio
KAIROS_S3_SECRET_KEY=kairos_minio_secret
KAIROS_S3_BUCKET=kairos-dev
KAIROS_S3_SECURE=false
KAIROS_OTEL_ENABLED=true
KAIROS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
KAIROS_CORS_ORIGINS=["http://localhost:5173"]
KAIROS_API_PORT=8000

# ---- Session cookie (M-02) ----
KAIROS_SESSION_COOKIE_NAME=kairos_session
KAIROS_SESSION_COOKIE_HTTPONLY=true
KAIROS_SESSION_COOKIE_SAMESITE=lax
# dev 允许 false；staging/production 必须 true
KAIROS_SESSION_COOKIE_SECURE=false
KAIROS_SESSION_COOKIE_MAX_AGE_SECONDS=604800

# ---- Auth 登录限流（M-02，内存实现，单实例 dev 适用） ----
KAIROS_AUTH_LOGIN_MAX_ATTEMPTS=5
KAIROS_AUTH_LOGIN_WINDOW_SECONDS=900

# ---- 前端 (vite dev server) ----
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8000
